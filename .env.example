# Role somente-leitura dashboard_readonly (criada no Plano 1, Task 5). A Vercel roda fora da rede
# privada do Railway, então use o host do PROXY PÚBLICO, nunca postgres.railway.internal.
DATABASE_URL=postgresql://dashboard_readonly:CHANGE_ME@host.proxy.rlwy.net:PORT/railway

